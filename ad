#!/usr/bin/env python3
"""Quick ad commands. See CLI.txt.

    ./ad "what the ad should be"      start one 10-second ad in the background
    ./ad "..." -n 3 -s 15             three ads, 15 seconds each
    ./ad                              no description: the agents pick the idea
    ./ad watch | status | list | pause | resume | cancel | upload | gui | doctor   [RUN_ID]
    ./ad cancel all                  cancel every unfinished job on this render machine
    ./ad cancel -a                   same as cancel all
"""
import json
import os
from pathlib import Path
import subprocess
import sys
import time

from harness.arguments import HelpfulParser, add_model_options

REPO = Path(__file__).resolve().parent
HOME = Path(os.environ.get('STUDIO_HARNESS_HOME', Path.home() / '.local/share/goosnav-ad-studio'))
COMMANDS = ('watch', 'status', 'list', 'pause', 'resume', 'cancel', 'upload', 'cooldown', 'gui', 'doctor', 'models')
DONE = ('complete', 'partial', 'failed', 'needs_review', 'waiting_provider', 'cancelled', 'interrupted', 'paused')


def harness(*args, capture=True):
    r = subprocess.run([sys.executable, '-m', 'harness', '--home', str(HOME), *args], cwd=REPO,
                       capture_output=capture, text=True)
    if capture and r.stdout.strip().startswith(('{', '[')):
        return json.loads(r.stdout)
    if capture and r.returncode:
        sys.exit(r.stderr.strip() or r.stdout.strip() or 'Command failed; see ./ad --help')
    return r


def latest():
    runs = harness('list')
    if not runs:
        sys.exit('No runs yet. Start one with: ./ad "what the ad should be"')
    return runs[0]['id']


def summary(run_id):
    s = harness('status', run_id)
    done = sum(t['stage'] == 'package' and t['status'] == 'succeeded' for t in s['tasks'])
    current = next((t for t in s['tasks'] if t['status'] in ('running', 'waiting_provider', 'failed', 'needs_review')), None)
    where = f" | {current['id']} {current['status']}" if current else ''
    print(f"{time.strftime('%H:%M')}  {run_id}  {s['status']}  {done}/{s['config']['count']} ads{where}", flush=True)
    if current and current['status'] == 'running' and current['attempts']:
        attempt = current['attempts'][-1]
        seconds = max(0, int(time.time() - attempt['started']))
        log = Path(attempt.get('log', ''))
        activity = (f'{int(time.time()-log.stat().st_mtime)}s since CLI output'
                    if log.is_file() else 'CLI has not written a log yet')
        print(f'  Worker: {attempt["provider"]}/{attempt["model"]} | '
              f'elapsed {seconds//60}m {seconds%60}s | {activity}')
    if s.get('delivery'):
        d = s['delivery']
        if d['status'] == 'uploaded':
            print(f'Drive: {d["remote"]}')
        elif d['status'] == 'failed':
            print(f'Drive delivery failed: {d.get("error", "unknown error")[:240]}\nRetry: ./ad upload {run_id}')
    if current and current['status'] == 'waiting_provider':
        print(f'  Provider blockers: {current.get("feedback", "No provider accepted this task")[:1200]}')
        print(f'  After fixing providers: ./ad resume {run_id}')
    if s['status'] in DONE:
        folder = s['config']['output'].get('folder')
        if done and folder:
            print(f'Videos: {Path(folder) / run_id}')
        if s['status'] in ('failed', 'needs_review') and current:
            print(f"Why: {(current['feedback'] or '')[:600]}\nThen: ./ad resume {run_id}   (or retry: "
                  f"python3 -m harness retry {run_id} --task {current['id']})")
        elif s['status'] in ('failed', 'needs_review') and s.get('error'):
            print(f"Why: {s['error'][:600]}\nThen: fix the source/configuration issue and ./ad resume {run_id}")
    return s['status']


def main():
    if len(sys.argv) > 1 and sys.argv[1] in COMMANDS:
        command, rest = sys.argv[1], sys.argv[2:]
        if command == 'gui':
            os.execv(str(REPO / 'Start Ad Studio.sh'), [str(REPO / 'Start Ad Studio.sh'), *rest])
        if command in ('doctor', 'models'):
            parser = HelpfulParser(prog=f'./ad {command}')
            parser.add_argument('--config')
            if command == 'models':
                add_model_options(parser)
            parser.parse_args(rest)
            return harness(command, *rest, capture=False).returncode
        parser = HelpfulParser(prog=f'./ad {command}')
        if command == 'cooldown':
            parser.add_argument('action', nargs='?', choices=('status', 'clear'), default='status')
            parser.add_argument('provider', nargs='?', choices=('codex', 'claude', 'all'), default='all')
        elif command != 'list':
            parser.add_argument('run_id', nargs='?', help='run ID (defaults to latest)')
            if command == 'cancel':
                parser.add_argument('-a', '--all', action='store_true', help='cancel all unfinished runs')
        options = parser.parse_args(rest)
        if command == 'cancel' and options.all and options.run_id is not None:
            parser.error('Use cancel --all OR cancel RUN_ID, not both')
        if command == 'list':
            for r in harness('list')[:15]:
                print(time.strftime('%m-%d %H:%M', time.localtime(r['created'])), r['id'], r['status'])
            return 0
        if command == 'cancel' and (options.all or options.run_id == 'all'):
            result = harness('cancel', '--all')
            if not isinstance(result, dict) or result.get('requested') != 'cancel_all':
                print('Failed to request cancellation; inspect: python3 -m harness cancel --all',
                      file=sys.stderr)
                return 1
            print(f"Cancellation requested for {result['count']} unfinished Ad Studio run(s).")
            for run_id in result['runs']:
                print('  ' + run_id)
            return 0
        run_id = None if command == 'cooldown' else options.run_id or latest()
        if command == 'status':
            summary(run_id); return 0
        if command == 'upload':
            result = harness('upload', run_id)
            if not isinstance(result, dict):
                print('Upload could not start (check rclone configuration).', file=sys.stderr)
                return 1
            d = result.get('delivery', {})
            if d.get('status') != 'uploaded':
                print(f'Drive upload failed: {d.get("error", "unknown error")}', file=sys.stderr)
                return 1
            print(f'Uploaded to Drive: {d["remote"]}')
            return 0
        if command == 'cooldown':
            result = harness('cooldown', options.action, options.provider)
            if isinstance(result, dict):
                if 'cleared' in result:
                    print(f"Cleared {result['cleared']} provider cooldown(s).")
                else:
                    for provider, seconds in result.items():
                        print(f'{provider}: {seconds}s remaining')
                return 0
            print('Could not inspect provider cooldowns.', file=sys.stderr)
            return 1
        if command == 'watch':
            while summary(run_id) not in DONE:
                time.sleep(60)
            return 0
        if command == 'resume':
            start('resume', run_id); return 0
        harness(command, run_id); print(f'{command} requested for {run_id}'); return 0
    p = HelpfulParser(prog='./ad', description='Make animated ads. See CLI.txt.',
                      epilog='Controls: ' + ', '.join(COMMANDS) + '. Use ./ad COMMAND --help for command options.')
    p.add_argument('concept', nargs='*', help='what the ad should be (quotes optional)')
    p.add_argument('-n', '--count', type=int, help='number of ads (default 1)')
    p.add_argument('-s', '--seconds', type=int, help='length of each ad (default 10)')
    add_model_options(p)
    p.add_argument('--config', help='project JSON configuration (default harness.local.json)')
    p.add_argument('--plan', action='store_true', help='save a run plan without starting workers')
    if sys.argv[1:] == ['help']:
        p.print_help(); return 0
    a = p.parse_intermixed_args()
    args = ['make']
    if a.concept:
        args += ['--concept', ' '.join(a.concept)]
    if a.count is not None:
        args += ['--count', str(a.count)]
    if a.seconds is not None:
        args += ['--seconds', str(a.seconds)]
    for key in ('effort', 'provider', 'config'):
        if getattr(a, key) is not None:
            args += ['--' + key, getattr(a, key)]
    if a.plan:
        return harness(*args, '--plan', capture=False).returncode
    start(*args)
    return 0


def start(*args):
    """Detached controller: it keeps going after this terminal closes."""
    logs = HOME / 'gui-logs'; logs.mkdir(parents=True, exist_ok=True)
    log = logs / f'{time.strftime("%Y%m%d-%H%M%S")}-{args[0]}.log'
    with log.open('w') as out:
        subprocess.Popen([sys.executable, '-m', 'harness', '--home', str(HOME), *args], cwd=REPO, stdout=out,
                         stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, start_new_session=True)
    for _ in range(60):
        time.sleep(0.5)
        text = log.read_text()
        if 'Run ' in text or args[0] == 'resume':
            break
        if '"error"' in text:
            sys.exit(text.strip())
    if args[0] != 'resume' and 'Run ' not in text:
        sys.exit(f'The run did not start; see {log}:\n{text[-1500:]}')
    run_id = args[1] if args[0] == 'resume' else text.split('Run ', 1)[1].split()[0]
    time.sleep(1.5)
    if '"error"' in log.read_text():
        sys.exit(log.read_text().strip())
    queued = 'queued' in log.read_text()
    print(f'{"Queued" if queued else "Started"} {run_id} in the background (log: {log}).\n'
          f'  ./ad watch      follow it        ./ad status     one line now\n'
          f'  ./ad pause      stop after the current step\n'
          f'  or open the GUI: ./ad gui')


if __name__ == '__main__':
    sys.exit(main())
